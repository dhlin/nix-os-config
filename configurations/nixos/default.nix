{
  config,
  flake,
  lib,
  ...
}: let
  inherit (flake) inputs;
  inherit (inputs) self;

  # Generated by `nix run .#install` on the machine itself. Guarded because
  # evaluating this configuration is what produces the installer in the first
  # place, so on a fresh boot the file does not exist yet.
  hardware = /etc/nixos/hardware-configuration.nix;
in {
  imports =
    [
      inputs.disko.nixosModules.disko
      self.nixosModules.default
      self.nixosModules.disk
      self.nixosModules.state
      self.nixosModules.user
    ]
    ++ lib.optional (builtins.pathExists hardware) hardware;

  users.primaryUser = "dhlin";

  home-manager.users.${config.users.primaryUser}.imports = [../home/default.nix];
}
